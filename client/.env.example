# Keep browser API calls same-origin.
# Local Vite proxies /api to http://localhost:5000.
# Production Vercel proxies /api to Render.
VITE_API_URL=/api

# Canonical frontend origin.
# Production example: https://www.your-bastly-domain.com
VITE_SITE_URL=http://localhost:5173

# BACKEND_URL is intentionally NOT a VITE_ variable.
# Set it in Vercel Project Environment Variables after the Render API exists:
# BACKEND_URL=https://your-bastly-api.onrender.com
