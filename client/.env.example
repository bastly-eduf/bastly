# Browser API calls stay same-origin. This is optional because /api is the code default.
VITE_API_URL=/api

# Canonical frontend origin.
# Local: http://localhost:5173
# Production: final Vercel/custom-domain origin.
VITE_SITE_URL=http://localhost:5173

# Public Bastly business/contact settings. These are intentionally VITE_ values because they are shown on the website.
VITE_BASTLY_WHATSAPP_NUMBER=201000883609
VITE_BASTLY_PHONE_DISPLAY=01000883609
VITE_BASTLY_INSTAGRAM_URL=https://www.instagram.com/bastly.eduf/

# BACKEND_URL is server/build-time only on Vercel, never VITE_.
# Set it after the Render API exists, e.g. https://bastly-api.onrender.com
BACKEND_URL=

# Advanced SEO override only. Normally leave unset; BACKEND_URL is enough.
SEO_API_URL=
