{
  "name": "bastly-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-build-env.mjs && vite build && node scripts/generate-static-seo.mjs",
    "build:production": "node scripts/check-build-env.mjs --production && vite build && node scripts/generate-static-seo.mjs --production",
    "cf:dev": "wrangler dev",
    "cf:dry-run": "wrangler deploy --dry-run",
    "preview": "vite preview",
    "check:env": "node scripts/check-build-env.mjs",
    "check:env:prod": "node scripts/check-build-env.mjs --production"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "axios": "^1.11.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.3.0",
    "vite": "^7.1.4",
    "wrangler": "^4.133.0"
  },
  "engines": {
    "node": ">=20.19 <23"
  }
}
