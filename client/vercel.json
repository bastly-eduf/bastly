{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${BACKEND_URL}/api/$1",
      "env": [
        "BACKEND_URL"
      ]
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/about/?$",
      "dest": "/about/index.html"
    },
    {
      "src": "^/faq/?$",
      "dest": "/faq/index.html"
    },
    {
      "src": "^/contact/?$",
      "dest": "/contact/index.html"
    },
    {
      "src": "^/courses/?$",
      "dest": "/courses/index.html"
    },
    {
      "src": "^/doctors/?$",
      "dest": "/doctors/index.html"
    },
    {
      "src": "^/courses/([a-z0-9-]+)/?$",
      "dest": "/courses/$1/index.html"
    },
    {
      "src": "^/doctors/([a-z0-9-]+)/?$",
      "dest": "/doctors/$1/index.html"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "dest": "/private.html"
    }
  ]
}
