NODE_ENV=development
PORT=5000

# Exact Bastly frontend origin. No path is needed.
CLIENT_URL=http://localhost:5173

# Development may omit this to use local MongoDB.
# Production: paste the owner-provided Atlas URI here/into Render.
MONGODB_URI=

# Development fallback exists, but never use it in production.
# Render generates this automatically from render.yaml. For another host run: npm run generate:jwt
JWT_SECRET=

# Development can stay false. Production MUST be true.
REQUIRE_EMAIL_VERIFICATION=false

# Gmail / Nodemailer.
# Use a Google App Password, never the normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Bastly Academy

# Cloudflare R2 media storage.
# Keep all five values server-only. Never expose the access/secret keys through VITE_ env vars.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=bastly-media
# Production should use the final R2 custom domain, e.g. https://media.yourdomain.com
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# One-time bootstrap only. These are read only by npm run seed:admin.
# Do not keep ADMIN_PASSWORD in production environment variables after the admin is created.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
