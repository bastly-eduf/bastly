NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string.
# Never commit your real value.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/bastly?retryWrites=true&w=majority

# Generate a long random value for production.
JWT_SECRET=replace-with-at-least-32-random-characters

# Keep false while developing locally. Turn true once verification email is implemented/configured.
REQUIRE_EMAIL_VERIFICATION=false

# Gmail is added in the dedicated email step.
GMAIL_USER=
GMAIL_APP_PASSWORD=
