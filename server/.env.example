NODE_ENV=development
PORT=5000

# Exact Bastly frontend origin. No path is needed.
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://YOUR_ATLAS_STANDARD_CONNECTION_STRING/bastly?YOUR_ATLAS_OPTIONS

# Use a long random secret. Production startup rejects secrets under 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters

# Development can stay false. Production MUST be true.
REQUIRE_EMAIL_VERIFICATION=false

# Gmail / Nodemailer.
# Use a Google App Password, never the normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Bastly Academy

# Cloudflare R2 media storage.
# Keep all five values server-only. Never expose the access/secret keys through VITE_ env vars.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=bastly-media
# During development this can be the bucket's r2.dev public URL.
# Production should use the final R2 custom domain, e.g. https://media.example.com
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Temporary bootstrap admin used during development / initial production setup.
# These values are only read by: npm run seed:admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
