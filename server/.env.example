NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://YOUR_ATLAS_STANDARD_CONNECTION_STRING/bastly?YOUR_ATLAS_OPTIONS

# Use a long random secret. Never commit the real value.
JWT_SECRET=replace-with-at-least-32-random-characters

# Development can stay false. Production should become true once Gmail is configured.
REQUIRE_EMAIL_VERIFICATION=false

# Gmail / Nodemailer.
# Use a Google App Password, never your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Bastly Academy

# Temporary bootstrap admin used during development.
# These values are only read by: npm run seed:admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
