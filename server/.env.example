NODE_ENV=development
PORT=5000

# Exact Bastly frontend origin. No path is needed.
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://YOUR_ATLAS_STANDARD_CONNECTION_STRING/bastly?YOUR_ATLAS_OPTIONS

# Use a long random secret. Production startup rejects secrets under 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters

# Development can stay false. Production MUST be true.
REQUIRE_EMAIL_VERIFICATION=false

# Gmail / Nodemailer.
# Use a Google App Password, never your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Bastly Academy

# Temporary bootstrap admin used during development / initial production setup.
# These values are only read by: npm run seed:admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
